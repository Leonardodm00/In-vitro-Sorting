file = h5py.File(fileDirectory + fileName, 'r')
# collect experiment information
samplingRate = file.attrs['SamplingRate']
chIdxs = np.array(file[wellID + '/StoredChIdxs'])

# Create a new file where the chIdx are numerically renamed form 0 to the max
# number of channels - 1. The two variables are mapped by the idx, whithin the arrays.

ROIs = np.range(len(chIdxs))


# #########################################

# Calculate the numebr of frames per Channel that equals the number of segmentes to 
# take along the data
Number_frames_ch = int(dataDurationSec*samplingRate)

# Variables for covertion from digital to analog

minDigitalValue = file.attrs['MinDigitalValue']
maxDigitalValue = file.attrs['MaxDigitalValue'] 
minAnalogValue = file.attrs['MinAnalogValue'] 
maxAnalogValue = file.attrs['MaxAnalogValue'] 

ConversionFactor =(maxAnalogValue - minAnalogValue) / (maxDigitalValue - minDigitalValue) 
OffsetValue = minAnalogValue - ConversionFactor * minDigitalValue 



# load the Raw data
data = file[wellID + '/Raw']


# TS: channels of interest row-wise, time course column-wise.

TS = np.zeros([Number_frames_ch,len(ROIs)])


# Construct the mask to extract the channel-related data points
  # For coherence when the original channel idx is retrieved 
                    # w.r.t. the row



for F in tqdm(range(Number_frames_ch-1)):
    
    # start = F*n_channels
    # stop = (F+1)* n_channels
    
    sl_data = data[F*n_channels:(F+1)*n_channels]
    data_channels = sl_data[ROIs]
    
    
    
    
    
    # Extracting channel-related indicies + convertion to analog
    
    TS[F,:] = OffsetValue + np.int16(data_channels)*ConversionFactor

    
   
del data

